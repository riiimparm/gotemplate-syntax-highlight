{
  "name": "gotmpl-syntax-highlighter",
  "displayName": "Gotmpl Syntax Highlighter",
  "description": "Syntax highlighting for .gotmpl (Go template) files used in Helmfiles",
  "version": "1.0.0",
  "publisher": "gotmpl",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "keywords": [
    "gotmpl",
    "go-template",
    "yaml go template",
    "helmfile",
    "helm",
    "syntax highlighting"
  ],
  "contributes": {
    "languages": [
      {
        "id": "yaml-gotmpl",
        "aliases": [
          "YAML with Go Template",
          "yaml-gotmpl"
        ],
        "extensions": [
          ".yaml.gotmpl",
          ".yml.gotmpl",
          "yaml.go.tpl",
          "yaml.go.templ"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yaml-gotmpl",
        "scopeName": "source.yaml.gotmpl",
        "path": "./syntaxes/yaml.gotmpl.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:yaml-gotmpl"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "vscode": "^1.1.37"
  }
}
